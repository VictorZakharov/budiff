<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>budiff</AssemblyName>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>budiff</ToolCommandName>
    <PackageId>budiff</PackageId>
    <Description>ls for diffs: a folder-scoped terminal diff viewer.</Description>
    <PackageTags>$(PackageTags);dotnet-tool;terminal</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LibGit2Sharp" Version="0.31.0" />
    <PackageReference Include="TextMateSharp.Grammars" Version="2.0.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Budiff.Core\Budiff.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Budiff.Shared\Git\*.cs" LinkBase="Shared\Git" />
  </ItemGroup>

  <!-- Ship the GUI inside the tool package so `budiff -i` works from any folder:
       publish Budiff.App and pack the publish output under tools/<tfm>/any/gui/win-x64/,
       where AppLauncher probes for it (Windows only). The publish is RID-specific
       ReadyToRun: it halves GUI time-to-window (~1.2s -> ~0.7s) AND shrinks the
       payload 4x (a portable publish carries native runtimes for every OS/arch,
       600 MB vs 159 MB). Non-Windows GUI packaging is tracked in issue #57. -->
  <Target Name="PublishGuiForPack" BeforeTargets="_GetPackageFiles">
    <PropertyGroup>
      <GuiPublishDir>$(MSBuildProjectDirectory)\obj\gui-publish\</GuiPublishDir>
    </PropertyGroup>
    <!-- Publish does not clean its output dir, so files from a previous pack
         (e.g. a differently-shaped publish) would silently ride along. -->
    <RemoveDir Directories="$(GuiPublishDir)" />
    <MSBuild Projects="..\Budiff.App\Budiff.App.csproj"
             Targets="Publish"
             Properties="Configuration=$(Configuration);RuntimeIdentifier=win-x64;SelfContained=false;PublishReadyToRun=true;PublishDir=$(GuiPublishDir)" />
    <ItemGroup>
      <None Include="$(GuiPublishDir)**\*"
            Pack="true"
            PackagePath="tools/$(TargetFramework)/any/gui/win-x64/%(RecursiveDir)" />
    </ItemGroup>
  </Target>
</Project>
