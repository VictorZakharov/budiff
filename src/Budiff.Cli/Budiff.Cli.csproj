<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>budiff</AssemblyName>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>budiff</ToolCommandName>
    <PackageId>budiff</PackageId>
    <Description>ls for diffs: a folder-scoped terminal diff viewer.</Description>
    <PackageTags>$(PackageTags);dotnet-tool;terminal</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LibGit2Sharp" Version="0.31.0" />
    <PackageReference Include="TextMateSharp.Grammars" Version="2.0.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Budiff.Core\Budiff.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Budiff.Shared\Git\*.cs" LinkBase="Shared\Git" />
  </ItemGroup>

  <!-- Ship the GUI inside the tool package so `budiff -i` works from any folder:
       publish Budiff.App and pack the publish output under tools/<tfm>/any/gui/,
       where AppLauncher probes for it. -->
  <Target Name="PublishGuiForPack" BeforeTargets="_GetPackageFiles">
    <PropertyGroup>
      <GuiPublishDir>$(MSBuildProjectDirectory)\obj\gui-publish\</GuiPublishDir>
    </PropertyGroup>
    <MSBuild Projects="..\Budiff.App\Budiff.App.csproj"
             Targets="Publish"
             Properties="Configuration=$(Configuration);PublishDir=$(GuiPublishDir)" />
    <ItemGroup>
      <None Include="$(GuiPublishDir)**\*"
            Pack="true"
            PackagePath="tools/$(TargetFramework)/any/gui/%(RecursiveDir)" />
    </ItemGroup>
  </Target>
</Project>
