<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Budiff.Avalonia"
             x:Class="Budiff.Avalonia.DiffView"
             x:Name="Root"
             x:CompileBindings="False">
    <DockPanel Background="{Binding EditorBackgroundBrush, ElementName=Root}">
        <!-- The title path lives in a star column and trims, so a long path or a
             narrow pane can never paint over the neighbors (a StackPanel here
             used to overflow across the checkbox). -->
        <Border DockPanel.Dock="Top"
                IsVisible="{Binding ShowHeader, ElementName=Root}"
                Background="{Binding ToolbarBrush, ElementName=Root}"
                BorderBrush="{Binding DiffBorderBrush, ElementName=Root}"
                BorderThickness="0,0,0,1"
                Padding="10,6"
                ClipToBounds="True">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <!-- The file name always keeps a readable minimum; past that the
                         right-side extras clip at the pane edge. -->
                    <ColumnDefinition Width="*" MinWidth="110" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Diff"
                           FontWeight="SemiBold"
                           Foreground="{Binding MutedTextBrush, ElementName=Root}"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="1"
                           Text="{Binding Title}"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Left"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{Binding TextBrush, ElementName=Root}"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="2"
                           Text="{Binding Subtitle}"
                           FontSize="11.5"
                           FontFamily="Cascadia Code,Consolas,monospace"
                           Foreground="{Binding MutedTextBrush, ElementName=Root}"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="3"
                           Text="Highlighting syntax..."
                           FontSize="11.5"
                           Foreground="{Binding MutedTextBrush, ElementName=Root}"
                           VerticalAlignment="Center"
                           IsVisible="{Binding IsHighlighting}" />
                <CheckBox Grid.Column="4"
                          IsChecked="{Binding ShowBlame}"
                          VerticalAlignment="Center"
                          Content="Blame"
                          FontSize="12.5"
                          Foreground="{Binding TextBrush, ElementName=Root}" />
                <CheckBox Grid.Column="5"
                          IsChecked="{Binding CollapseUnchanged}"
                          VerticalAlignment="Center"
                          Content="Collapse unchanged"
                          FontSize="12.5"
                          Foreground="{Binding TextBrush, ElementName=Root}" />
                <ContentPresenter Grid.Column="6"
                                  Content="{Binding HeaderExtra, ElementName=Root}"
                                  VerticalAlignment="Center" />
            </Grid>
        </Border>

        <ScrollBar DockPanel.Dock="Bottom"
                   Orientation="Horizontal"
                   IsVisible="{Binding HasHorizontalScroll}"
                   Minimum="0"
                   Maximum="{Binding MaxScroll}"
                   ViewportSize="120"
                   Value="{Binding HorizontalScroll, Mode=TwoWay}" />

        <Grid>
            <ScrollViewer IsVisible="{Binding !IsPlaceholder}"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <Grid>
                    <ItemsControl x:Name="RowsHost" ItemsSource="{Binding Rows}">
                        <!-- Virtualized: only the viewport's rows get containers, so a
                             Collapse-unchanged toggle or a big diff open realizes ~40
                             rows instead of one per line (which froze the UI). All
                             rows are a fixed 18px - DiffFunnelGutter relies on that. -->
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Panel>
                                    <Border IsVisible="{Binding IsGap}"
                                            Height="18"
                                            Cursor="Hand"
                                            Background="#14000000"
                                            BorderBrush="{Binding DiffBorderBrush, ElementName=Root}"
                                            BorderThickness="0,1"
                                            Tapped="OnGapTapped">
                                        <TextBlock Text="{Binding GapText}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontSize="11.5"
                                                   Foreground="{Binding MutedTextBrush, ElementName=Root}" />
                                    </Border>

                                    <Grid IsVisible="{Binding !IsGap}" Height="18" ColumnDefinitions="Auto,*,18,*">
                                        <!-- Blame gutter (#46): who last touched the OLD side's line;
                                             hover for the commit's details. Its own OUTER column, so
                                             showing it costs BOTH code halves equally. -->
                                        <TextBlock Grid.Column="0"
                                                   Width="120"
                                                   Text="{Binding Blame.Label}"
                                                   IsVisible="{Binding $parent[ItemsControl].DataContext.IsBlameVisible}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Padding="8,0,4,0"
                                                   FontSize="11"
                                                   VerticalAlignment="Center"
                                                   Foreground="{Binding MutedTextBrush, ElementName=Root}">
                                            <ToolTip.Tip>
                                                <StackPanel Spacing="3" MaxWidth="440">
                                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                                        <TextBlock Text="{Binding Blame.Sha}"
                                                                   FontFamily="Cascadia Code,Consolas,monospace"
                                                                   Foreground="#61AFEF" />
                                                        <TextBlock Text="{Binding Blame.Author}" FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding Blame.Email}" Foreground="#9DA0A8" />
                                                        <TextBlock Text="{Binding Blame.Date}" Foreground="#9DA0A8" />
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Blame.Message}" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </ToolTip.Tip>
                                        </TextBlock>
                                        <Border Grid.Column="1"
                                                Background="{Binding OldBackground}"
                                                BorderBrush="{Binding DiffBorderBrush, ElementName=Root}"
                                                BorderThickness="0,0,1,0">
                                            <Grid ColumnDefinitions="46,*">
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding OldNo}"
                                                           TextAlignment="Right"
                                                           Padding="0,0,8,0"
                                                           FontFamily="Cascadia Code,Consolas,monospace"
                                                           FontSize="12.5"
                                                           Foreground="{Binding MutedTextBrush, ElementName=Root}" />
                                                <ScrollViewer Grid.Column="1"
                                                              HorizontalScrollBarVisibility="Hidden"
                                                              VerticalScrollBarVisibility="Disabled"
                                                              Offset="{Binding $parent[ItemsControl].DataContext.HorizontalScroll, Converter={x:Static local:HScrollOffsetConverter.Instance}}">
                                                    <TextBlock local:DiffInlines.Runs="{Binding OldRuns}"
                                                               TextWrapping="NoWrap"
                                                               Padding="2,0,4,0"
                                                               FontFamily="Cascadia Code,Consolas,monospace"
                                                               FontSize="12.5"
                                                               Foreground="{Binding TextBrush, ElementName=Root}" />
                                                </ScrollViewer>
                                            </Grid>
                                        </Border>

                                        <Border Grid.Column="3" Background="{Binding NewBackground}">
                                            <Grid ColumnDefinitions="46,*">
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding NewNo}"
                                                           TextAlignment="Right"
                                                           Padding="0,0,8,0"
                                                           FontFamily="Cascadia Code,Consolas,monospace"
                                                           FontSize="12.5"
                                                           Foreground="{Binding MutedTextBrush, ElementName=Root}" />
                                                <ScrollViewer Grid.Column="1"
                                                              HorizontalScrollBarVisibility="Hidden"
                                                              VerticalScrollBarVisibility="Disabled"
                                                              Offset="{Binding $parent[ItemsControl].DataContext.HorizontalScroll, Converter={x:Static local:HScrollOffsetConverter.Instance}}">
                                                    <TextBlock local:DiffInlines.Runs="{Binding NewRuns}"
                                                               TextWrapping="NoWrap"
                                                               Padding="2,0,4,0"
                                                               FontFamily="Cascadia Code,Consolas,monospace"
                                                               FontSize="12.5"
                                                               Foreground="{Binding TextBrush, ElementName=Root}" />
                                                </ScrollViewer>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Panel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <local:DiffFunnelGutter Rows="{Binding Rows}"
                                            ItemsHost="{Binding #RowsHost}"
                                            BlameWidth="{Binding BlameGutterWidth}"
                                            AddedBrush="{Binding FunnelAddedBrush, ElementName=Root}"
                                            RemovedBrush="{Binding FunnelRemovedBrush, ElementName=Root}"
                                            ModifiedBrush="{Binding FunnelModifiedBrush, ElementName=Root}"
                                            IsHitTestVisible="False"
                                            VerticalAlignment="Stretch"
                                            HorizontalAlignment="Stretch" />
                </Grid>
            </ScrollViewer>

            <TextBlock IsVisible="{Binding IsPlaceholder}"
                       Text="{Binding Placeholder}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="13"
                       FontFamily="Cascadia Code,Consolas,monospace"
                       Foreground="{Binding MutedTextBrush, ElementName=Root}" />
        </Grid>
    </DockPanel>
</UserControl>
