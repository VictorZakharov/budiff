<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Budiff.Avalonia"
             x:Class="Budiff.Avalonia.DiffView"
             x:Name="Root"
             x:CompileBindings="False">
    <UserControl.Styles>
        <!-- Line wrap (the root's "wrap" class): code wraps inside its pane and
             rows grow taller; otherwise each code cell (CodeClip) shifts
             sideways with the shared horizontal scrollbar. -->
        <Style Selector="TextBlock.code">
            <Setter Property="TextWrapping" Value="NoWrap" />
        </Style>
        <Style Selector="DockPanel.wrap TextBlock.code">
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <!-- Unchanged context rows stay one line (trimmed) while collapsing;
             declared after the wrap style so it wins. -->
        <Style Selector="DockPanel.wrap Panel.compact TextBlock.code">
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <!-- One commit-details tooltip (#54) for the blame cell of BOTH row
             layouts - two-pane and the single-pane whole-file view. -->
        <Style Selector="TextBlock.blameCell">
            <Setter Property="Cursor" Value="Hand" />
            <!-- Heat: newer lines get a stronger tint (BlameEntry.Shade). -->
            <Setter Property="Background" Value="{Binding Blame.Shade}" />
            <Setter Property="ToolTip.Tip">
                <Template>
                    <StackPanel Spacing="3" MaxWidth="440">
                        <!-- Wrap panels: a long name or email moves down a line
                             instead of pushing the date out of the tooltip. -->
                        <WrapPanel>
                            <TextBlock Text="{Binding Blame.Sha}"
                                       FontFamily="Cascadia Code,Consolas,monospace"
                                       Foreground="#61AFEF"
                                       Margin="0,0,10,0" />
                            <TextBlock Text="{Binding Blame.Author}" FontWeight="SemiBold" Margin="0,0,10,0" />
                            <TextBlock Text="{Binding Blame.Email}" Foreground="#9DA0A8" />
                        </WrapPanel>
                        <TextBlock Text="{Binding Blame.Date}" Foreground="#9DA0A8" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Blame.Message}" TextWrapping="Wrap" />
                        <TextBlock Text="Click to open this commit"
                                   Foreground="#9DA0A8"
                                   FontSize="11"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </Template>
            </Setter>
        </Style>
    </UserControl.Styles>
    <DockPanel Background="{Binding EditorBackgroundBrush, ElementName=Root}"
               Classes.wrap="{Binding WrapLines}">
        <!-- The title path lives in a star column and trims, so a long path or a
             narrow pane can never paint over the neighbors (a StackPanel here
             used to overflow across the checkbox). -->
        <Border DockPanel.Dock="Top"
                IsVisible="{Binding ShowHeader, ElementName=Root}"
                Background="{Binding ToolbarBrush, ElementName=Root}"
                BorderBrush="{Binding DiffBorderBrush, ElementName=Root}"
                BorderThickness="0,0,0,1"
                Padding="10,6"
                ClipToBounds="True">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <!-- The file name always keeps a readable minimum; past that the
                         right-side extras clip at the pane edge. -->
                    <ColumnDefinition Width="*" MinWidth="110" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <!-- Back to the file a preview link was followed from. -->
                    <Button x:Name="BackButton"
                            Content="←"
                            IsVisible="{Binding CanGoBack}"
                            Command="{Binding GoBackCommand}"
                            ToolTip.Tip="Back (Alt+Left)"
                            Padding="6,0"
                            MinHeight="0"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{Binding TextBrush, ElementName=Root}"
                            VerticalAlignment="Center" />
                    <TextBlock Text="Diff"
                               IsVisible="{Binding !CanView}"
                               FontWeight="SemiBold"
                               Foreground="{Binding MutedTextBrush, ElementName=Root}"
                               VerticalAlignment="Center" />
                    <local:ViewModeSwitch IsVisible="{Binding CanView}" />
                </StackPanel>
                <TextBlock Grid.Column="1"
                           Text="{Binding Title}"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Left"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{Binding TextBrush, ElementName=Root}"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="2"
                           Text="{Binding Subtitle}"
                           FontSize="11.5"
                           FontFamily="Cascadia Code,Consolas,monospace"
                           Foreground="{Binding MutedTextBrush, ElementName=Root}"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="3"
                           Text="Highlighting syntax..."
                           FontSize="11.5"
                           Foreground="{Binding MutedTextBrush, ElementName=Root}"
                           VerticalAlignment="Center"
                           IsVisible="{Binding IsHighlighting}" />
                <CheckBox Grid.Column="4"
                          IsVisible="{Binding ShowBlameOption}"
                          IsChecked="{Binding ShowBlame}"
                          VerticalAlignment="Center"
                          Content="Blame"
                          FontSize="12.5"
                          Foreground="{Binding TextBrush, ElementName=Root}" />
                <CheckBox Grid.Column="5"
                          IsVisible="{Binding ShowCollapseOption}"
                          IsChecked="{Binding CollapseUnchanged}"
                          VerticalAlignment="Center"
                          Content="Collapse unchanged"
                          FontSize="12.5"
                          Foreground="{Binding TextBrush, ElementName=Root}" />
                <CheckBox Grid.Column="6"
                          IsVisible="{Binding ShowWrapOption}"
                          IsChecked="{Binding WrapLines}"
                          VerticalAlignment="Center"
                          Content="Wrap lines"
                          FontSize="12.5"
                          Foreground="{Binding TextBrush, ElementName=Root}" />
                <CheckBox Grid.Column="7"
                          IsVisible="{Binding CanPreview}"
                          IsChecked="{Binding ShowPreview}"
                          VerticalAlignment="Center"
                          Content="Preview"
                          FontSize="12.5"
                          Foreground="{Binding TextBrush, ElementName=Root}" />
                <ContentPresenter Grid.Column="8"
                                  Content="{Binding HeaderExtra, ElementName=Root}"
                                  VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- The wrapper owns visibility: a ScrollBar drives its OWN IsVisible
             from its Visibility, overriding a binding on it. -->
        <Border DockPanel.Dock="Bottom">
            <Border.IsVisible>
                <MultiBinding Converter="{x:Static BoolConverters.And}">
                    <Binding Path="HasHorizontalScroll" />
                    <Binding Path="!IsPreviewActive" />
                </MultiBinding>
            </Border.IsVisible>
            <ScrollBar Orientation="Horizontal"
                       Minimum="0"
                       Maximum="{Binding MaxScroll}"
                       ViewportSize="120"
                       Value="{Binding HorizontalScroll, Mode=TwoWay}" />
        </Border>

        <Grid>
            <ScrollViewer x:Name="RowsScroller"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <ScrollViewer.IsVisible>
                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                        <Binding Path="!IsPlaceholder" />
                        <Binding Path="!IsPreviewActive" />
                    </MultiBinding>
                </ScrollViewer.IsVisible>
                <Grid>
                    <local:DiffRowsHost x:Name="RowsHost" ItemsSource="{Binding Rows}">
                        <!-- Virtualized: only the viewport's rows get containers, so a
                             Collapse-unchanged toggle or a big diff open realizes ~40
                             rows instead of one per line (which froze the UI). All
                             rows are a fixed 18px - DiffFunnelGutter relies on that.
                             A scrollable diff shifts it 1px up (DiffView.KeepTopAnchored). -->
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Panel Classes.compact="{Binding IsCompact}">
                                    <Border IsVisible="{Binding IsGap}"
                                            Height="18"
                                            Cursor="Hand"
                                            Background="#14000000"
                                            BorderBrush="{Binding DiffBorderBrush, ElementName=Root}"
                                            BorderThickness="0,1"
                                            Tapped="OnGapTapped">
                                        <TextBlock Text="{Binding GapText}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontSize="11.5"
                                                   Foreground="{Binding MutedTextBrush, ElementName=Root}" />
                                    </Border>

                                    <!-- Single-pane layout (#48): a wholly added/deleted diff
                                         shows only its populated side at full width. -->
                                    <Grid MinHeight="18" ColumnDefinitions="Auto,46,*">
                                        <Grid.IsVisible>
                                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                                                <Binding Path="!IsGap" />
                                                <Binding Path="$parent[ItemsControl].DataContext.IsSinglePane" />
                                            </MultiBinding>
                                        </Grid.IsVisible>
                                        <TextBlock Grid.Column="0"
                                                   Classes="blameCell"
                                                   Tapped="OnBlameTapped"
                                                   Width="{Binding $parent[ItemsControl].DataContext.BlameLabelWidth}"
                                                   Text="{Binding Blame.Label}"
                                                   IsVisible="{Binding $parent[ItemsControl].DataContext.IsBlameVisible}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Padding="8,2,4,0"
                                                   FontSize="11"
                                                   VerticalAlignment="Top"
                                                   Foreground="{Binding MutedTextBrush, ElementName=Root}" />
                                        <Border Grid.Column="1" Grid.ColumnSpan="2">
                                            <Grid ColumnDefinitions="46,*">
                                                <!-- Added / removed gutter bar (the whole file is one or the other). -->
                                                <Border Grid.Column="0"
                                                        Width="3"
                                                        HorizontalAlignment="Right"
                                                        Background="{Binding SingleMarker}" />
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding SingleNo}"
                                                           TextAlignment="Right"
                                                           Padding="0,0,8,0"
                                                           FontFamily="Cascadia Code,Consolas,monospace"
                                                           FontSize="12.5"
                                                           Foreground="{Binding MutedTextBrush, ElementName=Root}" />
                                                <local:CodeClip Grid.Column="1"
                                                                ScrollX="{Binding $parent[ItemsControl].DataContext.HorizontalScroll}">
                                                    <TextBlock local:DiffInlines.Runs="{Binding SingleRuns}"
                                                               Classes="code"
                                                               Padding="2,0,4,0"
                                                               FontFamily="Cascadia Code,Consolas,monospace"
                                                               FontSize="12.5"
                                                               Foreground="{Binding TextBrush, ElementName=Root}" />
                                                </local:CodeClip>
                                            </Grid>
                                        </Border>
                                    </Grid>

                                    <!-- Columns: blame | old | funnel gutter | new; the
                                         halves are weighted by SplitRatio (drag the gutter). -->
                                    <local:DiffSplitGrid MinHeight="18"
                                                         SplitRatio="{Binding $parent[ItemsControl].DataContext.SplitRatio}">
                                        <local:DiffSplitGrid.IsVisible>
                                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                                                <Binding Path="!IsGap" />
                                                <Binding Path="!$parent[ItemsControl].DataContext.IsSinglePane" />
                                            </MultiBinding>
                                        </local:DiffSplitGrid.IsVisible>
                                        <!-- Blame gutter (#46): who last touched the line as it is now
                                             (a removed line: as it was);
                                             hover for the commit's details. Its own OUTER column, so
                                             showing it costs BOTH code halves equally. -->
                                        <TextBlock Grid.Column="0"
                                                   Classes="blameCell"
                                                   Tapped="OnBlameTapped"
                                                   Width="{Binding $parent[ItemsControl].DataContext.BlameLabelWidth}"
                                                   Text="{Binding Blame.Label}"
                                                   IsVisible="{Binding $parent[ItemsControl].DataContext.IsBlameVisible}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Padding="8,2,4,0"
                                                   FontSize="11"
                                                   VerticalAlignment="Top"
                                                   Foreground="{Binding MutedTextBrush, ElementName=Root}" />
                                        <Border Grid.Column="1"
                                                Background="{Binding OldBackground}"
                                                BorderBrush="{Binding DiffBorderBrush, ElementName=Root}"
                                                BorderThickness="0,0,1,0">
                                            <Grid ColumnDefinitions="46,*">
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding OldNo}"
                                                           TextAlignment="Right"
                                                           Padding="0,0,8,0"
                                                           FontFamily="Cascadia Code,Consolas,monospace"
                                                           FontSize="12.5"
                                                           Foreground="{Binding MutedTextBrush, ElementName=Root}" />
                                                <local:CodeClip Grid.Column="1"
                                                                ScrollX="{Binding $parent[ItemsControl].DataContext.HorizontalScroll}">
                                                    <TextBlock local:DiffInlines.Runs="{Binding OldRuns}"
                                                               Classes="code"
                                                               Padding="2,0,4,0"
                                                               FontFamily="Cascadia Code,Consolas,monospace"
                                                               FontSize="12.5"
                                                               Foreground="{Binding TextBrush, ElementName=Root}" />
                                                </local:CodeClip>
                                            </Grid>
                                        </Border>

                                        <Border Grid.Column="3" Background="{Binding NewBackground}">
                                            <Grid ColumnDefinitions="46,*">
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding NewNo}"
                                                           TextAlignment="Right"
                                                           Padding="0,0,8,0"
                                                           FontFamily="Cascadia Code,Consolas,monospace"
                                                           FontSize="12.5"
                                                           Foreground="{Binding MutedTextBrush, ElementName=Root}" />
                                                <local:CodeClip Grid.Column="1"
                                                                ScrollX="{Binding $parent[ItemsControl].DataContext.HorizontalScroll}">
                                                    <TextBlock local:DiffInlines.Runs="{Binding NewRuns}"
                                                               Classes="code"
                                                               Padding="2,0,4,0"
                                                               FontFamily="Cascadia Code,Consolas,monospace"
                                                               FontSize="12.5"
                                                               Foreground="{Binding TextBrush, ElementName=Root}" />
                                                </local:CodeClip>
                                            </Grid>
                                        </Border>
                                    </local:DiffSplitGrid>
                                </Panel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </local:DiffRowsHost>

                    <local:DiffFunnelGutter Rows="{Binding Rows}"
                                            ItemsHost="{Binding #RowsHost}"
                                            BlameWidth="{Binding BlameGutterWidth}"
                                            SplitRatio="{Binding SplitRatio, Mode=TwoWay}"
                                            IsVisible="{Binding !IsSinglePane}"
                                            AddedBrush="{Binding FunnelAddedBrush, ElementName=Root}"
                                            RemovedBrush="{Binding FunnelRemovedBrush, ElementName=Root}"
                                            ModifiedBrush="{Binding FunnelModifiedBrush, ElementName=Root}"
                                            VerticalAlignment="Stretch"
                                            HorizontalAlignment="Stretch" />
                </Grid>
            </ScrollViewer>

            <!-- Formatted preview (e.g. markdown), rendered by the model's
                 IDocumentPreviewer in place of the line diff. -->
            <ContentControl x:Name="PreviewHost"
                            IsVisible="{Binding IsPreviewActive}"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch" />

            <TextBlock IsVisible="{Binding IsPlaceholder}"
                       Text="{Binding Placeholder}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="13"
                       FontFamily="Cascadia Code,Consolas,monospace"
                       Foreground="{Binding MutedTextBrush, ElementName=Root}" />
        </Grid>
    </DockPanel>
</UserControl>
