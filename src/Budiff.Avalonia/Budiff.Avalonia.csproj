<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Avalonia side-by-side diff control for budiff.</Description>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <PackageTags>$(PackageTags);diff-control;ui</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.0.4" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Budiff.Core\Budiff.Core.csproj" />
  </ItemGroup>

</Project>
