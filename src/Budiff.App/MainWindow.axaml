<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ca="using:Budiff.CodeAnalysis"
        xmlns:app="using:Budiff.App"
        xmlns:budiff="using:Budiff.Avalonia"
        x:Class="Budiff.App.MainWindow"
        x:CompileBindings="False"
        Width="1440"
        Height="820"
        MinWidth="1180"
        MinHeight="560"
        Title="{Binding WindowTitle}">
    <Window.Resources>
        <!-- The bird's-eye column chooser, shared by the header's right-click and
             its corner button. One check item per column goes between the
             separators, added in code (MainWindow.AddColumnMenuItems). The checks
             keep the menu open to pick several; Reset closes it. -->
        <MenuFlyout x:Key="ColumnMenu" Placement="BottomEdgeAlignedRight">
            <MenuItem Header="All columns" ToggleType="CheckBox" StaysOpenOnClick="True" IsChecked="{Binding AllColumnsOn, Mode=TwoWay}" />
            <Separator />
            <Separator />
            <MenuItem Header="Reset to default" Command="{Binding ResetColumnsCommand}" />
        </MenuFlyout>
    </Window.Resources>
    <Window.Styles>
        <Style Selector="TreeViewItem">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            <Setter Property="IsVisible" Value="{Binding IsSearchVisible}" />
        </Style>
        <!-- Chromeless tree items: no built-in toggle/indent, so EVERY row grid
             spans the full pane width and its columns land exactly where the
             header's do at any width (the default chrome shifted rows right
             once the name column hit its minimum). Indent + chevron are drawn
             inside the name cell instead (Depth on the row VM). -->
        <Style Selector="TreeView#AnalysisTree TreeViewItem">
            <Setter Property="Padding" Value="0" />
            <!-- The Fluent theme's TreeViewItem MinHeight is taller than the
                 24px row content, leaving a dead un-highlighted band between
                 rows (hover/selection looked like disconnected stripes).
                 Zeroing it makes rows contiguous so the highlight rolls from
                 one row to the next. -->
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Template">
                <ControlTemplate>
                    <StackPanel>
                        <Border Name="PART_LayoutRoot"
                                Background="Transparent"
                                Focusable="True">
                            <ContentPresenter Name="PART_HeaderPresenter"
                                              Content="{TemplateBinding Header}"
                                              ContentTemplate="{TemplateBinding HeaderTemplate}"
                                              HorizontalContentAlignment="Stretch" />
                        </Border>
                        <ItemsPresenter Name="PART_ItemsPresenter"
                                        IsVisible="{TemplateBinding IsExpanded}"
                                        ItemsPanel="{TemplateBinding ItemsPanel}" />
                    </StackPanel>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="TreeView#AnalysisTree TreeViewItem:pointerover /template/ Border#PART_LayoutRoot">
            <Setter Property="Background" Value="#14FFFFFF" />
        </Style>
        <Style Selector="TreeView#AnalysisTree TreeViewItem:selected /template/ Border#PART_LayoutRoot">
            <Setter Property="Background" Value="#2D5A9E" />
        </Style>
        <Style Selector="Button.chevron">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
        </Style>
        <Style Selector="Button.segment">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{DynamicResource BudiffMutedTextBrush}" />
        </Style>
        <Style Selector="Button.segment.active">
            <Setter Property="Background" Value="#2D5A9E" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>
        <!-- The container border is rounded (4) but ClipToBounds clips to the
             RECTANGULAR bounds, so a square highlight pokes into the rounded
             corners. Round each segment's outer corners instead (4 minus the
             1px border). -->
        <Style Selector="Button.segment.small">
            <Setter Property="Padding" Value="9,2" />
            <Setter Property="FontSize" Value="11.5" />
        </Style>
        <Style Selector="Button.segment.left">
            <Setter Property="CornerRadius" Value="3,0,0,3" />
        </Style>
        <Style Selector="Button.segment.right">
            <Setter Property="CornerRadius" Value="0,3,3,0" />
        </Style>
        <Style Selector="TextBlock.num">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontFamily" Value="Cascadia Code,Consolas,monospace" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="8,0,8,0" />
        </Style>
        <Style Selector="ProgressBar.size">
            <Setter Property="Height" Value="7" />
            <Setter Property="MinHeight" Value="7" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Foreground" Value="#61AFEF" />
            <Setter Property="Background" Value="#22FFFFFF" />
            <Setter Property="CornerRadius" Value="3" />
        </Style>
        <Style Selector="Button.colHeader">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Right" />
        </Style>
        <Style Selector="Button.colHeader TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource BudiffMutedTextBrush}" />
        </Style>
        <Style Selector="Button.diffTool">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="5,3" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*" Background="{DynamicResource BudiffEditorBackgroundBrush}">
        <Border Grid.Row="0"
                Padding="10,8"
                Background="{DynamicResource BudiffToolbarBrush}"
                BorderBrush="{DynamicResource BudiffBorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <app:AppIcon Kind="FileCompare" Width="18" Height="18"
                                 Foreground="{DynamicResource BudiffMutedTextBrush}" />
                    <StackPanel>
                        <TextBlock Text="{Binding RepoTitle}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource BudiffTextBrush}" />
                        <TextBlock Text="{Binding ScopeTitle}"
                                   FontSize="11.5"
                                   Foreground="{DynamicResource BudiffMutedTextBrush}" />
                    </StackPanel>
                </StackPanel>

                <TextBlock Grid.Column="1"
                           Text="{Binding StatusText}"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource BudiffMutedTextBrush}"
                           TextTrimming="CharacterEllipsis" />

                <Button Grid.Column="2"
                        Padding="8,4"
                        Click="OnOpenFolder"
                        ToolTip.Tip="Open folder">
                    <app:AppIcon Kind="FolderOpen" Width="18" Height="18" />
                </Button>

                <Button Grid.Column="3"
                        Padding="8,4"
                        Command="{Binding RefreshCommand}"
                        ToolTip.Tip="Refresh">
                    <app:AppIcon Kind="Refresh" Width="18" Height="18" />
                </Button>
            </Grid>
        </Border>

        <!-- Diff hidden by default: columns 1 (splitter) and 2 (diff) start at 0 and are
             sized from code-behind when a diff opens (see MainWindow.ApplyDiffLayout). -->
        <Grid Grid.Row="1" x:Name="BodyGrid" ColumnDefinitions="*,0,0">
            <DockPanel Grid.Column="0" x:Name="BirdsEyePanel" Background="#252629">
                <Border DockPanel.Dock="Top"
                        IsVisible="{Binding ShowScopeOffer}"
                        Padding="10,8"
                        Background="#202B3F"
                        BorderBrush="#314A70"
                        BorderThickness="0,0,0,1">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBlock Text="Showing only this folder."
                                   Foreground="{DynamicResource BudiffTextBrush}"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="1"
                                Content="Use repo root"
                                Command="{Binding UseRepoRootCommand}"
                                Padding="8,4" />
                    </Grid>
                </Border>

                <Border DockPanel.Dock="Top"
                        Padding="10,8"
                        Background="{DynamicResource BudiffToolbarBrush}"
                        BorderBrush="{DynamicResource BudiffBorderBrush}"
                        BorderThickness="0,0,0,1"
                        ClipToBounds="True">
                    <StackPanel Spacing="8">
                        <!-- When the filter box would get too narrow, it wraps (with
                             Reset) to a second row; narrower still, the period controls
                             wrap under the grouping switch too (MainWindow.UpdateToolbarWrap).
                             Past that the toolbar clips at the pane edge instead of controls
                             painting over each other. Gaps are left margins, not
                             ColumnSpacing, so empty columns cost no width. -->
                        <Grid x:Name="ToolbarGrid" RowDefinitions="Auto,Auto">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <!-- Segmented Folders/Projects switch (#49): both labels
                                 visible, the active side highlighted - one click flips. -->
                            <Border x:Name="GroupingSwitch"
                                    BorderBrush="{DynamicResource BudiffBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    ClipToBounds="True"
                                    VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <Button Classes="segment left"
                                            Classes.active="{Binding Analysis.IsFoldersGrouping}"
                                            Content="Folders"
                                            Command="{Binding Analysis.SelectGroupingCommand}"
                                            CommandParameter="{Binding Analysis.Groupings[0]}" />
                                    <Button Classes="segment right"
                                            Classes.active="{Binding Analysis.IsProjectsGrouping}"
                                            Content="Projects"
                                            Command="{Binding Analysis.SelectGroupingCommand}"
                                            CommandParameter="{Binding Analysis.Groupings[1]}" />
                                </StackPanel>
                            </Border>
                            <!-- The compact toolbar's stand-in for the switch: a drop-down,
                                 so the period picker still fits beside it. -->
                            <ComboBox x:Name="GroupingBox"
                                      Width="100"
                                      IsVisible="False"
                                      VerticalAlignment="Center"
                                      ItemsSource="{Binding Analysis.Groupings}"
                                      SelectedItem="{Binding Analysis.SelectedGrouping, Mode=TwoWay}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Label}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <StackPanel Grid.Column="1" x:Name="PeriodBar" Margin="10,0,0,0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <!-- Hidden in the compact (wrapped) toolbar: the picker says it. -->
                                <TextBlock x:Name="PeriodLabel" Text="Period" Foreground="{DynamicResource BudiffMutedTextBrush}" VerticalAlignment="Center" />
                                <!-- Picking "Pull request..." again reopens the picker. -->
                                <app:RepickComboBox x:Name="PeriodBox"
                                                    Width="132"
                                                    ItemsSource="{Binding Analysis.Periods}"
                                                    IsEnabled="{Binding Analysis.GitAvailable}"
                                                    SelectedItem="{Binding Analysis.SelectedPeriod, Mode=TwoWay}"
                                                    RepickCommand="{Binding Analysis.RepickPeriodCommand}">
                                    <app:RepickComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Label}" />
                                        </DataTemplate>
                                    </app:RepickComboBox.ItemTemplate>
                                </app:RepickComboBox>
                                <TextBox Width="52"
                                         Text="{Binding Analysis.CustomDaysText, Mode=TwoWay}"
                                         IsVisible="{Binding Analysis.IsCustomPeriod}"
                                         VerticalAlignment="Center"
                                         ToolTip.Tip="Window size in days (0 = all time)" />
                                <TextBlock Text="days"
                                           Foreground="{DynamicResource BudiffMutedTextBrush}"
                                           IsVisible="{Binding Analysis.IsCustomPeriod}"
                                           VerticalAlignment="Center" />
                                <!-- The applied pull request; click to pick another. -->
                                <!-- A Grid (not a StackPanel) so a long title actually
                                     trims inside MaxWidth instead of painting over the
                                     filter box next to it. -->
                                <Button IsVisible="{Binding Analysis.IsPullRequestPeriod}"
                                        Command="{Binding Analysis.ChoosePullRequestCommand}"
                                        MaxWidth="180"
                                        Padding="8,4"
                                        ClipToBounds="True"
                                        HorizontalContentAlignment="Stretch"
                                        VerticalAlignment="Center"
                                        ToolTip.Tip="{Binding Analysis.PullRequestTip}">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                                        <app:AppIcon Kind="SourcePull" Width="14" Height="14"
                                                     Foreground="{DynamicResource BudiffMutedTextBrush}" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Analysis.PullRequestButtonText}"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </Button>
                                <!-- The commit this window was opened on (a blame click). -->
                                <Border IsVisible="{Binding Analysis.IsCommitPeriod}"
                                        MaxWidth="220"
                                        Padding="8,4"
                                        CornerRadius="4"
                                        Background="{DynamicResource BudiffToolbarBrush}"
                                        VerticalAlignment="Center"
                                        ToolTip.Tip="{Binding Analysis.CommitTip}">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                                        <app:AppIcon Kind="SourceCommit" Width="14" Height="14"
                                                     Foreground="{DynamicResource BudiffMutedTextBrush}" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Analysis.CommitButtonText}"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <!-- Reset lives inside the filter box: an X that shows once the
                                 view differs from its defaults (filter, extension / author
                                 checks, sort, grouping, period) and puts them all back. -->
                            <Grid Grid.Column="2" x:Name="FilterRow" Margin="10,0,0,0">
                                <TextBox x:Name="FilterBox"
                                         MinWidth="84"
                                         PlaceholderText="Filter files..."
                                         Text="{Binding Analysis.SearchText, Mode=TwoWay}"
                                         VerticalAlignment="Center">
                                    <TextBox.InnerRightContent>
                                        <Button x:Name="ResetButton"
                                                Classes="diffTool"
                                                Margin="0,0,4,0"
                                                IsVisible="{Binding Analysis.CanResetView}"
                                                Command="{Binding Analysis.ResetViewCommand}"
                                                ToolTip.Tip="Reset the view: filter, extensions, authors, sort, grouping and period">
                                            <app:AppIcon Kind="Close" Width="14" Height="14"
                                                         Foreground="{DynamicResource BudiffMutedTextBrush}" />
                                        </Button>
                                    </TextBox.InnerRightContent>
                                </TextBox>
                            </Grid>

                            <StackPanel Grid.Column="3" x:Name="ScanIndicator" Margin="10,0,0,0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                                        IsVisible="{Binding Analysis.IsScanning}">
                                <ProgressBar IsIndeterminate="True" Width="72" Height="6" />
                                <TextBlock Text="Scanning" Foreground="{DynamicResource BudiffMutedTextBrush}" />
                            </StackPanel>
                        </Grid>

                        <!-- The summary wraps in a narrow pane instead of running off its
                             edge; the Tree/City switch (and the city's colouring) sit at its end. -->
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock x:Name="SummaryLine" Text="{Binding Analysis.SummaryText}" FontSize="12" TextWrapping="Wrap"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource BudiffMutedTextBrush}" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="10,0,0,0" VerticalAlignment="Center">
                                <CheckBox x:Name="ShowFpsBox"
                                          IsVisible="{Binding Analysis.IsCityView}"
                                          IsChecked="{Binding Analysis.ShowCityFps, Mode=TwoWay}"
                                          Content="Show FPS"
                                          FontSize="11.5"
                                          MinHeight="0"
                                          Padding="4,0,0,0"
                                          VerticalAlignment="Center"
                                          Foreground="{DynamicResource BudiffMutedTextBrush}"
                                          ToolTip.Tip="A performance panel in the city: FPS over the last 15 s; click it to copy a debug report" />
                                <Border x:Name="CityModeSwitch"
                                        IsVisible="{Binding Analysis.IsCityView}"
                                        BorderBrush="{DynamicResource BudiffBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        ClipToBounds="True">
                                    <StackPanel Orientation="Horizontal">
                                        <Button Classes="segment left small"
                                                Classes.active="{Binding Analysis.IsCityHotspots}"
                                                Content="Hotspots"
                                                ToolTip.Tip="Height = churn, colour = churn &#215; size: big files that keep changing glow red"
                                                Command="{Binding Analysis.ShowHotspotsCommand}" />
                                        <Button Classes="segment right small"
                                                Classes.active="{Binding Analysis.IsCityAge}"
                                                Content="Age"
                                                ToolTip.Tip="Height = commits, colour = how recently it changed"
                                                Command="{Binding Analysis.ShowAgeCommand}" />
                                    </StackPanel>
                                </Border>
                                <Border x:Name="ViewSwitch"
                                        BorderBrush="{DynamicResource BudiffBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        ClipToBounds="True">
                                    <StackPanel Orientation="Horizontal">
                                        <Button Classes="segment left small"
                                                Classes.active="{Binding Analysis.IsTreeView}"
                                                Content="Tree"
                                                Command="{Binding Analysis.ShowTreeCommand}" />
                                        <Button x:Name="CityButton"
                                                Classes="segment right small"
                                                Classes.active="{Binding Analysis.IsCityView}"
                                                Content="City"
                                                ToolTip.Tip="The code as a 3D city: folders are districts, files are buildings"
                                                Command="{Binding Analysis.ShowCityCommand}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border DockPanel.Dock="Right"
                        Width="220"
                        IsVisible="{Binding ShowWideColumns}"
                        Background="#222326"
                        BorderBrush="{DynamicResource BudiffBorderBrush}"
                        BorderThickness="1,0,0,0">
                    <!-- The EXTENSIONS/AUTHORS split is re-proportioned to the data on
                         load (see MainWindow.ApplyFilterSplit) so neither pane scrolls
                         while the other wastes space. -->
                    <Grid x:Name="FilterGrid" RowDefinitions="*,5,*">
                        <DockPanel Grid.Row="0">
                            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto" Margin="12,10,10,8">
                                <TextBlock Text="EXTENSIONS" FontSize="11" FontWeight="SemiBold"
                                           Foreground="#61AFEF" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Content="All" Command="{Binding Analysis.SelectAllExtensionsCommand}"
                                        IsEnabled="{Binding Analysis.CanSelectAllExtensions}" Padding="7,2" FontSize="11" />
                                <Button Grid.Column="2" Content="None" Command="{Binding Analysis.SelectNoExtensionsCommand}"
                                        IsEnabled="{Binding Analysis.CanSelectNoneExtensions}" Padding="7,2" FontSize="11" Margin="6,0,0,0" />
                            </Grid>
                            <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding Analysis.Extensions}" Margin="8,0,8,10">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding Included, Mode=TwoWay}" Margin="4,2" Padding="6,0,0,0">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Display}" FontSize="13" FontFamily="Cascadia Code,Consolas,monospace" />
                                                    <TextBlock Text="{Binding Summary}" FontSize="11" Foreground="{DynamicResource BudiffMutedTextBrush}" />
                                                </StackPanel>
                                            </CheckBox>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>

                        <GridSplitter Grid.Row="1" Height="5" ResizeDirection="Rows" HorizontalAlignment="Stretch"
                                      Background="{DynamicResource BudiffBorderBrush}" />

                        <DockPanel Grid.Row="2">
                            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto" Margin="12,10,10,8">
                                <TextBlock Text="AUTHORS" FontSize="11" FontWeight="SemiBold"
                                           Foreground="#61AFEF" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Content="All" Command="{Binding Analysis.SelectAllAuthorsCommand}"
                                        IsEnabled="{Binding Analysis.CanSelectAllAuthors}" Padding="7,2" FontSize="11" />
                                <Button Grid.Column="2" Content="None" Command="{Binding Analysis.SelectNoneAuthorsCommand}"
                                        IsEnabled="{Binding Analysis.CanSelectNoneAuthors}" Padding="7,2" FontSize="11" Margin="6,0,0,0" />
                            </Grid>
                            <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding Analysis.Authors}" Margin="8,0,8,10">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding Included, Mode=TwoWay}" Margin="4,2" Padding="6,0,0,0">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Author}" FontSize="13" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Summary}" FontSize="11" Foreground="{DynamicResource BudiffMutedTextBrush}" />
                                                </StackPanel>
                                            </CheckBox>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Grid>
                </Border>

                <!-- ClipToBounds: the fixed-width columns overflow to the right in a
                     very narrow pane; clip them at the pane edge instead of letting
                     the header/rows paint under the filter panes. -->
                <Panel>
                <app:CityGlView x:Name="CityGl" IsVisible="{Binding Analysis.IsCityView}" />
                <app:CodeCityView x:Name="CodeCity"
                                  IsVisible="{Binding Analysis.IsCityView}"
                                  Model="{Binding Analysis.City}"
                                  SearchText="{Binding Analysis.SearchText}"
                                  OpenCommand="{Binding Analysis.OpenCityFileCommand}"
                                  ShowFps="{Binding Analysis.ShowCityFps}" />
                <DockPanel x:Name="TreeArea" ClipToBounds="True" IsVisible="{Binding Analysis.IsTreeView}">
                    <!-- Right-click the header (or the button in its corner) to pick columns. -->
                    <Border DockPanel.Dock="Top"
                            Background="Transparent"
                            BorderBrush="{DynamicResource BudiffBorderBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="6,6,18,6">
                        <Border.ContextFlyout>
                            <StaticResource ResourceKey="ColumnMenu" />
                        </Border.ContextFlyout>
                        <!-- Every column but Name sits in an Auto column whose fixed-width
                             content can hide, collapsing the column to zero. Added / Removed
                             hide only when turned off in the chooser. Blank /
                             Comment / Files / Size only show without the docked diff; as the pane
                             narrows, columns drop Size, Files, Comment, Blank, then Authors,
                             Commits, Code and Lines (see MainWindowViewModel.FitColumns); columns
                             turned off in the chooser never show. Header and row cells use matching
                             total widths so the columns stay aligned. -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <!-- Name keeps a readable minimum; below even the
                                     always-on columns, the rightmost ones clip at the
                                     pane edge (rows use the same defs, so alignment
                                     survives). -->
                                <ColumnDefinition Width="*" MinWidth="150" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Classes="colHeader" HorizontalContentAlignment="Left"
                                    Command="{Binding Analysis.SortCommand}" CommandParameter="{x:Static ca:AnalysisSortKey.Name}">
                                <StackPanel Orientation="Horizontal" Spacing="3">
                                    <TextBlock Text="Name" /><TextBlock Text="{Binding Analysis.NameGlyph}" FontSize="9" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="1" Classes="colHeader" Width="72" IsVisible="{Binding ShowLinesColumn}" Command="{Binding Analysis.SortCommand}" CommandParameter="{x:Static ca:AnalysisSortKey.Lines}">
                                <StackPanel Orientation="Horizontal" Spacing="3" HorizontalAlignment="Right">
                                    <TextBlock Text="Lines" /><TextBlock Text="{Binding Analysis.LinesGlyph}" FontSize="9" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="2" Classes="colHeader" Width="72" IsVisible="{Binding ShowCodeColumn}" Command="{Binding Analysis.SortCommand}" CommandParameter="{x:Static ca:AnalysisSortKey.Code}">
                                <StackPanel Orientation="Horizontal" Spacing="3" HorizontalAlignment="Right">
                                    <TextBlock Text="Code" /><TextBlock Text="{Binding Analysis.CodeGlyph}" FontSize="9" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="3" Classes="colHeader" Width="64" IsVisible="{Binding ShowBlankColumn}" Command="{Binding Analysis.SortCommand}" CommandParameter="{x:Static ca:AnalysisSortKey.Blank}">
                                <StackPanel Orientation="Horizontal" Spacing="3" HorizontalAlignment="Right">
                                    <TextBlock Text="Blank" /><TextBlock Text="{Binding Analysis.BlankGlyph}" FontSize="9" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="4" Classes="colHeader" Width="76" IsVisible="{Binding ShowCommentColumn}" Command="{Binding Analysis.SortCommand}" CommandParameter="{x:Static ca:AnalysisSortKey.Comment}">
                                <StackPanel Orientation="Horizontal" Spacing="3" HorizontalAlignment="Right">
                                    <TextBlock Text="Comment" /><TextBlock Text="{Binding Analysis.CommentGlyph}" FontSize="9" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="5" Classes="colHeader" Width="54" IsVisible="{Binding ShowFilesColumn}" Command="{Binding Analysis.SortCommand}" CommandParameter="{x:Static ca:AnalysisSortKey.Files}">
                                <StackPanel Orientation="Horizontal" Spacing="3" HorizontalAlignment="Right">
                                    <TextBlock Text="Files" /><TextBlock Text="{Binding Analysis.FilesGlyph}" FontSize="9" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="6" Classes="colHeader" Width="78" IsVisible="{Binding ShowAddedColumn}" Command="{Binding Analysis.SortCommand}" CommandParameter="{x:Static ca:AnalysisSortKey.Added}">
                                <StackPanel Orientation="Horizontal" Spacing="3" HorizontalAlignment="Right">
                                    <TextBlock Text="Added" /><TextBlock Text="{Binding Analysis.AddedGlyph}" FontSize="9" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="7" Classes="colHeader" Width="78" IsVisible="{Binding ShowRemovedColumn}" Command="{Binding Analysis.SortCommand}" CommandParameter="{x:Static ca:AnalysisSortKey.Removed}">
                                <StackPanel Orientation="Horizontal" Spacing="3" HorizontalAlignment="Right">
                                    <TextBlock Text="Removed" /><TextBlock Text="{Binding Analysis.RemovedGlyph}" FontSize="9" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="8" Classes="colHeader" Width="64" IsVisible="{Binding ShowCommitsColumn}" Command="{Binding Analysis.SortCommand}" CommandParameter="{x:Static ca:AnalysisSortKey.Commits}">
                                <StackPanel Orientation="Horizontal" Spacing="3" HorizontalAlignment="Right">
                                    <TextBlock Text="Commits" /><TextBlock Text="{Binding Analysis.CommitsGlyph}" FontSize="9" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="9" Classes="colHeader" Width="60" IsVisible="{Binding ShowAuthorsColumn}" Command="{Binding Analysis.SortCommand}" CommandParameter="{x:Static ca:AnalysisSortKey.Authors}">
                                <StackPanel Orientation="Horizontal" Spacing="3" HorizontalAlignment="Right">
                                    <TextBlock Text="Authors" /><TextBlock Text="{Binding Analysis.AuthorsGlyph}" FontSize="9" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="10" Classes="colHeader" Width="64" IsVisible="{Binding ShowRecencyColumn}" Command="{Binding Analysis.SortCommand}" CommandParameter="{x:Static ca:AnalysisSortKey.Recency}"
                                    ToolTip.Tip="How long ago it last changed (the newest commit in the period)">
                                <StackPanel Orientation="Horizontal" Spacing="3" HorizontalAlignment="Right">
                                    <TextBlock Text="Recency" /><TextBlock Text="{Binding Analysis.RecencyGlyph}" FontSize="9" />
                                </StackPanel>
                            </Button>
                            <TextBlock Grid.Column="11" Text="Size" FontSize="11" FontWeight="SemiBold" Width="78" IsVisible="{Binding ShowSizeColumn}"
                                       Foreground="{DynamicResource BudiffMutedTextBrush}" VerticalAlignment="Center" Margin="12,0,0,0" />
                            <!-- Sits in the header's right padding, above the rows' scrollbar. -->
                            <Button x:Name="ColumnsButton" Grid.ColumnSpan="12" Classes="diffTool" HorizontalAlignment="Right"
                                    Width="18" Margin="0,0,-18,0" Padding="0" ToolTip.Tip="Columns">
                                <app:AppIcon Kind="Tune" Width="13" Height="13"
                                             Foreground="{DynamicResource BudiffMutedTextBrush}" />
                                <Button.Flyout>
                                    <StaticResource ResourceKey="ColumnMenu" />
                                </Button.Flyout>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Horizontal scrolling is disabled so row grids are constrained
                         to the viewport - the same width the header grid gets - and
                         the two stay column-aligned at any pane width. (With it on,
                         rows size to the scroll EXTENT and drift right of the header
                         the moment content outgrows a narrow pane.) -->
                    <TreeView x:Name="AnalysisTree"
                              ItemsSource="{Binding Analysis.Roots}"
                              DoubleTapped="OnAnalysisRowDoubleTapped"
                              Background="Transparent"
                              BorderThickness="0"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.AllowAutoHide="True"
                              Padding="6,0,18,0">
                        <TreeView.ItemTemplate>
                            <TreeDataTemplate ItemsSource="{Binding Children}">
                                <Grid Height="24" Background="Transparent">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" MinWidth="150" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <!-- Auto,Auto,Auto,* (not a StackPanel) so the name TRIMS
                                         when the cell is tight instead of pushing the row wider.
                                         Indent + chevron live here (chromeless TreeViewItem). -->
                                    <!-- The name runs on over the empty cells to its right and up to
                                         the next number, keeping clear of it (NameExtent). -->
                                    <Grid Grid.Column="0" ColumnDefinitions="Auto,Auto,Auto,*" VerticalAlignment="Center">
                                        <Grid.ColumnSpan>
                                            <MultiBinding Converter="{x:Static app:NameSpanConverter.Instance}">
                                                <Binding />
                                                <Binding Path="$parent[Window].DataContext.VisibleCells" />
                                            </MultiBinding>
                                        </Grid.ColumnSpan>
                                        <Grid.Margin>
                                            <MultiBinding Converter="{x:Static app:NameReserveConverter.Instance}">
                                                <Binding />
                                                <Binding Path="$parent[Window].DataContext.VisibleCells" />
                                            </MultiBinding>
                                        </Grid.Margin>
                                        <Border Width="{Binding IndentWidth}" />
                                        <Panel Grid.Column="1" Width="18">
                                            <Button Classes="chevron" Click="OnToggleExpand" IsVisible="{Binding !IsFile}">
                                                <app:AppIcon Kind="{Binding ExpandIcon}" Width="14" Height="14"
                                                             Foreground="{DynamicResource BudiffMutedTextBrush}" />
                                            </Button>
                                        </Panel>
                                        <app:AppIcon Grid.Column="2" Kind="{Binding Icon}" Tint="{Binding IconTint}" Width="15" Height="15"
                                                     Foreground="{DynamicResource BudiffMutedTextBrush}" />
                                        <TextBlock Grid.Column="3" app:NameInlines.Runs="{Binding NameRuns}" Padding="2,0" Margin="6,0,0,0"
                                                   HorizontalAlignment="Left"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource BudiffTextBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip.Tip="{Binding Name}"
                                                   ToolTip.ToolTipOpening="OnNameTipOpening" />
                                    </Grid>
                                    <TextBlock Grid.Column="1" Classes="num" Width="56" TextAlignment="Right" Text="{Binding LinesText}" Foreground="{DynamicResource BudiffTextBrush}"
                                               IsVisible="{Binding $parent[Window].DataContext.ShowLinesColumn}" />
                                    <TextBlock Grid.Column="2" Classes="num" Width="56" TextAlignment="Right" Text="{Binding CodeText}" Foreground="{DynamicResource BudiffTextBrush}"
                                               IsVisible="{Binding $parent[Window].DataContext.ShowCodeColumn}" />
                                    <TextBlock Grid.Column="3" Classes="num" Width="48" TextAlignment="Right" Text="{Binding BlankText}" Foreground="#6E747E"
                                               IsVisible="{Binding $parent[Window].DataContext.ShowBlankColumn}" />
                                    <TextBlock Grid.Column="4" Classes="num" Width="60" TextAlignment="Right" Text="{Binding CommentText}" Foreground="#5E8C5E"
                                               IsVisible="{Binding $parent[Window].DataContext.ShowCommentColumn}" />
                                    <TextBlock Grid.Column="5" Classes="num" Width="38" TextAlignment="Right" Text="{Binding FilesText}" Foreground="{DynamicResource BudiffMutedTextBrush}"
                                               IsVisible="{Binding $parent[Window].DataContext.ShowFilesColumn}" />
                                    <TextBlock Grid.Column="6" Classes="num" Width="62" TextAlignment="Right" Text="{Binding AddedText}" Foreground="#6BB36B"
                                               IsVisible="{Binding $parent[Window].DataContext.ShowAddedColumn}" />
                                    <TextBlock Grid.Column="7" Classes="num" Width="62" TextAlignment="Right" Text="{Binding RemovedText}" Foreground="#D16969"
                                               IsVisible="{Binding $parent[Window].DataContext.ShowRemovedColumn}" />
                                    <TextBlock Grid.Column="8" Classes="num" Width="48" TextAlignment="Right" Text="{Binding CommitsText}" Foreground="{DynamicResource BudiffMutedTextBrush}"
                                               IsVisible="{Binding $parent[Window].DataContext.ShowCommitsColumn}" />
                                    <TextBlock Grid.Column="9" Classes="num" Width="44" TextAlignment="Right" Text="{Binding AuthorsText}" Foreground="{DynamicResource BudiffMutedTextBrush}"
                                               IsVisible="{Binding $parent[Window].DataContext.ShowAuthorsColumn}" />
                                    <TextBlock Grid.Column="10" Classes="num" Width="48" TextAlignment="Right" Text="{Binding RecencyText}" Foreground="{DynamicResource BudiffMutedTextBrush}"
                                               IsVisible="{Binding $parent[Window].DataContext.ShowRecencyColumn}" />
                                    <ProgressBar Grid.Column="11" Classes="size" Minimum="0" Maximum="1" Width="70"
                                                 IsVisible="{Binding $parent[Window].DataContext.ShowSizeColumn}"
                                                 Value="{Binding BarFraction}" VerticalAlignment="Center" Margin="12,0,8,0" />
                                </Grid>
                            </TreeDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </DockPanel>
                </Panel>
            </DockPanel>

            <GridSplitter Grid.Column="1"
                          x:Name="BodySplitter"
                          IsVisible="False"
                          ResizeDirection="Columns"
                          Background="{DynamicResource BudiffBorderBrush}"
                          HorizontalAlignment="Stretch" />

            <DockPanel Grid.Column="2" x:Name="DiffHost" IsVisible="False">
                <Border DockPanel.Dock="Top"
                        Background="{DynamicResource BudiffToolbarBrush}"
                        BorderBrush="{DynamicResource BudiffBorderBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="4,2"
                        ClipToBounds="True">
                    <!-- ONE compact control row (#47): chevron, Diff <file>, Base,
                         Working tree, Blame, Collapse unchanged, Wrap, Preview - then
                         float and close, pinned right so they never clip. The title and
                         the combo sit in shrinkable star columns (title keeps a 110px
                         floor, combo caps at 170 / floors at 90) so nothing overlaps
                         in a narrow pane. -->
                    <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6" Margin="6,0,0,0">
                        <!-- Every toggle again, for when the row above clips them
                             (shown only then - see MainWindow.UpdateDiffOptionsOverflow).
                             It always keeps its slot; only opacity changes. -->
                        <Button x:Name="DiffOptionsOverflow"
                                Classes="diffTool"
                                Opacity="0"
                                IsHitTestVisible="False"
                                ToolTip.Tip="View options">
                            <app:AppIcon Kind="Tune" Width="16" Height="16"
                                         Foreground="{DynamicResource BudiffMutedTextBrush}" />
                            <Button.Flyout>
                                <MenuFlyout Placement="BottomEdgeAlignedRight">
                                    <MenuItem Header="Working tree" ToggleType="CheckBox"
                                              IsVisible="{Binding ShowCompareOptions}"
                                              IsChecked="{Binding IncludeWorkingTree, Mode=TwoWay}" />
                                    <MenuItem Header="Blame" ToggleType="CheckBox"
                                              IsVisible="{Binding Diff.ShowBlameOption}"
                                              IsChecked="{Binding Diff.ShowBlame, Mode=TwoWay}" />
                                    <MenuItem Header="Collapse unchanged" ToggleType="CheckBox"
                                              IsVisible="{Binding Diff.ShowDiffOptions}"
                                              IsChecked="{Binding Diff.CollapseUnchanged, Mode=TwoWay}" />
                                    <MenuItem Header="Wrap lines" ToggleType="CheckBox"
                                              IsVisible="{Binding Diff.ShowWrapOption}"
                                              IsChecked="{Binding Diff.WrapLines, Mode=TwoWay}" />
                                    <MenuItem Header="Preview" ToggleType="CheckBox"
                                              IsVisible="{Binding Diff.CanPreview}"
                                              IsChecked="{Binding Diff.ShowPreview, Mode=TwoWay}" />
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                        <Button Classes="diffTool"
                                Click="OnFloatDiff"
                                ToolTip.Tip="Open diff in its own window">
                            <app:AppIcon Kind="OpenInNew" Width="16" Height="16"
                                         Foreground="{DynamicResource BudiffMutedTextBrush}" />
                        </Button>
                        <Button Classes="diffTool"
                                Command="{Binding CloseDiffCommand}"
                                ToolTip.Tip="Close diff">
                            <app:AppIcon Kind="Close" Width="16" Height="16"
                                         Foreground="{DynamicResource BudiffMutedTextBrush}" />
                        </Button>
                    </StackPanel>
                    <Grid x:Name="DiffToolbarGrid" ColumnSpacing="6" MinHeight="26" ClipToBounds="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" MinWidth="110" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="1000*" MaxWidth="170" MinWidth="90" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Classes="diffTool"
                                Command="{Binding ToggleTreeCommand}"
                                ToolTip.Tip="{Binding TreeToggleTip}">
                            <app:AppIcon Kind="{Binding TreeToggleIcon}" Width="16" Height="16"
                                         Foreground="{DynamicResource BudiffMutedTextBrush}" />
                        </Button>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                            <!-- Back to the file a preview link was followed from. -->
                            <Button x:Name="DiffBackButton"
                                    Classes="diffTool"
                                    IsVisible="{Binding Diff.CanGoBack}"
                                    Command="{Binding Diff.GoBackCommand}"
                                    ToolTip.Tip="Back (Alt+Left)">
                                <app:AppIcon Kind="ArrowLeft" Width="16" Height="16"
                                             Foreground="{DynamicResource BudiffTextBrush}" />
                            </Button>
                            <TextBlock Text="Diff" FontWeight="SemiBold" FontSize="12"
                                       Foreground="{DynamicResource BudiffMutedTextBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="{Binding Diff.Title}" FontWeight="SemiBold" FontSize="12"
                                   HorizontalAlignment="Left" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource BudiffTextBrush}" VerticalAlignment="Center" />

                        <!-- Comparison controls live with the diff: base branch only;
                             head is the working tree (or HEAD when the toggle is off). -->
                        <TextBlock Grid.Column="3" Text="Base" FontSize="12" IsVisible="{Binding ShowCompareOptions}" Foreground="{DynamicResource BudiffMutedTextBrush}" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="4" FontSize="12"
                                  IsVisible="{Binding ShowCompareOptions}"
                                  HorizontalAlignment="Stretch"
                                  ItemsSource="{Binding BaseRefs}"
                                  SelectedItem="{Binding SelectedBaseRef, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <CheckBox Grid.Column="5"
                                  IsVisible="{Binding ShowCompareOptions}"
                                  IsChecked="{Binding IncludeWorkingTree, Mode=TwoWay}"
                                  Content="Working tree"
                                  FontSize="12"
                                  VerticalAlignment="Center"
                                  Foreground="{DynamicResource BudiffTextBrush}"
                                  ToolTip.Tip="Include uncommitted working-tree changes. Off = compare to the last commit, as if your changes were not made yet." />
                        <CheckBox Grid.Column="6"
                                  IsVisible="{Binding Diff.ShowBlameOption}"
                                  IsChecked="{Binding Diff.ShowBlame, Mode=TwoWay}"
                                  Content="Blame"
                                  FontSize="12"
                                  VerticalAlignment="Center"
                                  Foreground="{DynamicResource BudiffTextBrush}"
                                  ToolTip.Tip="Show who last touched each line. Auto-hides when the pane drops under half the window (the checkmark tracks it); re-check to force it on." />
                        <CheckBox Grid.Column="7"
                                  IsVisible="{Binding Diff.ShowDiffOptions}"
                                  IsChecked="{Binding Diff.CollapseUnchanged, Mode=TwoWay}"
                                  Content="Collapse unchanged"
                                  FontSize="12"
                                  VerticalAlignment="Center"
                                  Foreground="{DynamicResource BudiffTextBrush}" />
                        <CheckBox Grid.Column="8"
                                  IsVisible="{Binding Diff.ShowWrapOption}"
                                  IsChecked="{Binding Diff.WrapLines, Mode=TwoWay}"
                                  Content="Wrap"
                                  FontSize="12"
                                  VerticalAlignment="Center"
                                  Foreground="{DynamicResource BudiffTextBrush}"
                                  ToolTip.Tip="Wrap long lines inside each pane instead of scrolling sideways." />
                        <CheckBox Grid.Column="9"
                                  IsVisible="{Binding Diff.CanPreview}"
                                  IsChecked="{Binding Diff.ShowPreview, Mode=TwoWay}"
                                  Content="Preview"
                                  FontSize="12"
                                  VerticalAlignment="Center"
                                  Foreground="{DynamicResource BudiffTextBrush}"
                                  ToolTip.Tip="Show the document formatted, with changed blocks marked (old in red, new in green)." />
                    </Grid>
                    </DockPanel>
                </Border>

                <!-- Thin comparison strip: just what is being compared. -->
                <Border DockPanel.Dock="Top"
                        Background="{DynamicResource BudiffToolbarBrush}"
                        BorderBrush="{DynamicResource BudiffBorderBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="10,1"
                        ClipToBounds="True">
                    <TextBlock Text="{Binding Diff.Subtitle}"
                               FontSize="11"
                               FontFamily="Cascadia Code,Consolas,monospace"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource BudiffMutedTextBrush}" />
                </Border>
                <budiff:DiffView DataContext="{Binding Diff}" ShowHeader="False" />
            </DockPanel>
        </Grid>
    </Grid>
</Window>
