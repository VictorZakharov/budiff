<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:budiff="using:Budiff.Avalonia"
        xmlns:materialIcons="using:Material.Icons.Avalonia"
        x:Class="Budiff.App.MainWindow"
        x:CompileBindings="False"
        Width="1180"
        Height="760"
        MinWidth="900"
        MinHeight="560"
        Title="{Binding WindowTitle}">
    <Grid RowDefinitions="Auto,*" Background="{DynamicResource BudiffEditorBackgroundBrush}">
        <Border Grid.Row="0"
                Padding="10,8"
                Background="{DynamicResource BudiffToolbarBrush}"
                BorderBrush="{DynamicResource BudiffBorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto" ColumnSpacing="10">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <materialIcons:MaterialIcon Kind="FileCompare" Width="18" Height="18"
                                                Foreground="{DynamicResource BudiffMutedTextBrush}" />
                    <StackPanel>
                        <TextBlock Text="{Binding RepoTitle}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource BudiffTextBrush}" />
                        <TextBlock Text="{Binding ScopeTitle}"
                                   FontSize="11.5"
                                   Foreground="{DynamicResource BudiffMutedTextBrush}" />
                    </StackPanel>
                </StackPanel>

                <TextBlock Grid.Column="1"
                           Text="{Binding StatusText}"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource BudiffMutedTextBrush}"
                           TextTrimming="CharacterEllipsis" />

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <TextBlock Text="Base" Foreground="{DynamicResource BudiffMutedTextBrush}" VerticalAlignment="Center" />
                    <ComboBox Width="210"
                              ItemsSource="{Binding BaseRefs}"
                              SelectedItem="{Binding SelectedBaseRef, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Display}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <TextBlock Text="Head" Foreground="{DynamicResource BudiffMutedTextBrush}" VerticalAlignment="Center" />
                    <ComboBox Width="230"
                              ItemsSource="{Binding HeadRefs}"
                              SelectedItem="{Binding SelectedHeadRef, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Display}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <Button Grid.Column="4"
                        Padding="8,4"
                        Click="OnOpenFolder"
                        ToolTip.Tip="Open folder">
                    <materialIcons:MaterialIcon Kind="FolderOpen" Width="18" Height="18" />
                </Button>

                <Button Grid.Column="5"
                        Padding="8,4"
                        Command="{Binding RefreshCommand}"
                        ToolTip.Tip="Refresh">
                    <materialIcons:MaterialIcon Kind="Refresh" Width="18" Height="18" />
                </Button>
            </Grid>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="340,*">
            <Border Grid.Column="0"
                    Background="#252629"
                    BorderBrush="{DynamicResource BudiffBorderBrush}"
                    BorderThickness="0,0,1,0">
                <DockPanel>
                    <Border DockPanel.Dock="Top"
                            IsVisible="{Binding ShowScopeOffer}"
                            Padding="10,8"
                            Background="#202B3F"
                            BorderBrush="#314A70"
                            BorderThickness="0,0,0,1">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBlock Text="Showing only this folder."
                                       Foreground="{DynamicResource BudiffTextBrush}"
                                       VerticalAlignment="Center" />
                            <Button Grid.Column="1"
                                    Content="Use repo root"
                                    Command="{Binding UseRepoRootCommand}"
                                    Padding="8,4" />
                        </Grid>
                    </Border>

                    <Border DockPanel.Dock="Top"
                            Padding="10,8"
                            BorderBrush="{DynamicResource BudiffBorderBrush}"
                            BorderThickness="0,0,0,1">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="Changed files"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource BudiffTextBrush}"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding FileCountText}"
                                       Foreground="{DynamicResource BudiffMutedTextBrush}"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <TextBlock Text="{Binding EmptyText}"
                               IsVisible="{Binding HasNoFiles}"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="24"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource BudiffMutedTextBrush}" />

                    <ListBox ItemsSource="{Binding Files}"
                             SelectedItem="{Binding SelectedFile, Mode=TwoWay}"
                             Background="Transparent"
                             BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="32,*,Auto" ColumnSpacing="8" MinHeight="44" Margin="0,2">
                                    <TextBlock Text="{Binding StateText}"
                                               Foreground="{Binding StateBrush}"
                                               FontFamily="Cascadia Code,Consolas,monospace"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Center" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Path}"
                                                   Foreground="{DynamicResource BudiffTextBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding DetailText}"
                                                   FontSize="11.5"
                                                   Foreground="{DynamicResource BudiffMutedTextBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding AddedText}" Foreground="#7EE787" />
                                        <TextBlock Text="{Binding RemovedText}" Foreground="#FF7B72" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <budiff:DiffView Grid.Column="1" DataContext="{Binding Diff}" />
        </Grid>
    </Grid>
</Window>
