<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="using:Budiff.App"
        xmlns:materialIcons="using:Material.Icons.Avalonia"
        x:Class="Budiff.App.PullRequestPickerWindow"
        x:CompileBindings="False"
        Title="Show changes by pull request"
        Width="760"
        Height="560"
        MinWidth="520"
        MinHeight="320"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource BudiffEditorBackgroundBrush}">
    <Window.Styles>
        <Style Selector="ListBox#ResultList ListBoxItem">
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <Style Selector="TextBlock.muted">
            <Setter Property="Foreground" Value="{DynamicResource BudiffMutedTextBrush}" />
        </Style>
        <!-- Notes ("Loading people...") are rows, not choices. -->
        <Style Selector="ComboBox#AuthorBox ComboBoxItem">
            <Setter Property="IsEnabled" Value="{Binding !IsNote}" />
            <Setter Property="Padding" Value="8,5" />
        </Style>
    </Window.Styles>

    <DockPanel Margin="12">
        <!-- Filters: free text (#number, words, or raw GitHub qualifiers),
             author (Mine / Anyone / a repo person - listed on first drop-down,
             or typed), state. -->
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,200,Auto,110" ColumnSpacing="8" Margin="0,0,0,10">
            <TextBox x:Name="SearchBox"
                     PlaceholderText="Search: words, #123, label:bug, base:main"
                     ToolTip.Tip="Words match title and body; #123 jumps to that PR; GitHub search qualifiers (label:, base:, head:, review:...) pass through."
                     Text="{Binding SearchText, Mode=TwoWay}"
                     VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Classes="muted" Text="Author" VerticalAlignment="Center" />
            <ComboBox x:Name="AuthorBox"
                      Grid.Column="2"
                      IsEditable="True"
                      HorizontalAlignment="Stretch"
                      ItemsSource="{Binding AuthorOptions}"
                      Text="{Binding AuthorText, Mode=TwoWay}"
                      MaxDropDownHeight="400"
                      ToolTip.Tip="{Binding MineHint}"
                      VerticalAlignment="Center">
                <!-- A card per choice: picture (initials until it arrives)
                     or icon, then name over login and email. -->
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" MinWidth="240" MaxWidth="380">
                            <Panel Width="28" Height="28" VerticalAlignment="Center" IsVisible="{Binding !IsNote}">
                                <Border IsVisible="{Binding HasIcon}" CornerRadius="14"
                                        Background="{DynamicResource BudiffMutedTextBrush}" Opacity="0.25" />
                                <materialIcons:MaterialIcon IsVisible="{Binding HasIcon}" Kind="{Binding IconKind}" Width="18" Height="18" />
                                <Border IsVisible="{Binding HasAvatar}" CornerRadius="14" ClipToBounds="True"
                                        Background="{Binding Avatar.Background}">
                                    <Panel>
                                        <TextBlock Text="{Binding Avatar.Initials}" Foreground="White" FontSize="11" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <Image Source="{Binding Avatar.Image}" Stretch="UniformToFill" />
                                    </Panel>
                                </Border>
                            </Panel>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Classes="muted" FontSize="11" Text="{Binding Subtitle}" IsVisible="{Binding HasSubtitle}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Grid.Column="3" Classes="muted" Text="State" VerticalAlignment="Center" />
            <ComboBox Grid.Column="4"
                      HorizontalAlignment="Stretch"
                      ItemsSource="{Binding States}"
                      SelectedItem="{Binding SelectedState, Mode=TwoWay}"
                      VerticalAlignment="Center">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Label}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </Grid>

        <Grid DockPanel.Dock="Bottom" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8" Margin="0,10,0,0">
            <ProgressBar IsIndeterminate="True" Width="60" Height="4"
                         IsVisible="{Binding IsLoading}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Classes="muted" Text="{Binding StatusText}" VerticalAlignment="Center" />
            <Button Grid.Column="2" Content="Cancel" IsCancel="True" Click="OnCancel" />
            <Button Grid.Column="3" Content="Show changes" IsDefault="True" Classes="accent"
                    IsEnabled="{Binding CanShow}" Click="OnShow" />
        </Grid>

        <Border DockPanel.Dock="Top"
                IsVisible="{Binding HasError}"
                Background="#33DA3633"
                CornerRadius="4"
                Padding="10,6"
                Margin="0,0,0,8">
            <TextBlock Text="{Binding ErrorText}" TextWrapping="Wrap" Foreground="{DynamicResource BudiffTextBrush}" />
        </Border>

        <Border BorderBrush="{DynamicResource BudiffBorderBrush}" BorderThickness="1" CornerRadius="4">
            <ListBox x:Name="ResultList"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     Background="Transparent"
                     ItemsSource="{Binding Items}"
                     SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                     DoubleTapped="OnRowDoubleTapped">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="10">
                            <Border Grid.RowSpan="2"
                                    Background="{Binding StateBrush}"
                                    CornerRadius="10"
                                    Padding="8,1"
                                    MinWidth="62"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding StateLabel}" FontSize="11" FontWeight="SemiBold"
                                           Foreground="White" HorizontalAlignment="Center" />
                            </Border>
                            <!-- Grid, not a StackPanel: a long title must trim, not run under the stats. -->
                            <Grid Grid.Column="1" ColumnDefinitions="Auto,*" ColumnSpacing="6">
                                <TextBlock Classes="muted" Text="{Binding NumberText}" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource BudiffTextBrush}" />
                            </Grid>
                            <TextBlock Grid.Column="1" Grid.Row="1" Classes="muted" FontSize="11.5"
                                       Text="{Binding Meta}" TextTrimming="CharacterEllipsis" />
                            <StackPanel Grid.Column="2" Grid.RowSpan="2" Orientation="Horizontal" Spacing="8"
                                        VerticalAlignment="Center">
                                <TextBlock Text="{Binding Added}" Foreground="#3FB950" FontFamily="Cascadia Code,Consolas,monospace" FontSize="12" />
                                <TextBlock Text="{Binding Removed}" Foreground="#F85149" FontFamily="Cascadia Code,Consolas,monospace" FontSize="12" />
                                <TextBlock Classes="muted" Text="{Binding Files}" FontSize="12" MinWidth="52" TextAlignment="Right" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </DockPanel>
</Window>
