<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialIcons="using:Material.Icons.Avalonia"
             x:Class="Budiff.App.App"
             RequestedThemeVariant="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Budiff.Avalonia/Themes/BudiffTheme.axaml" />
            </ResourceDictionary.MergedDictionaries>
            <Color x:Key="SystemAccentColor">#3574F0</Color>
            <Color x:Key="SystemAccentColorDark1">#2E63D6</Color>
            <Color x:Key="SystemAccentColorDark2">#2856BC</Color>
            <Color x:Key="SystemAccentColorDark3">#214AA2</Color>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <materialIcons:MaterialIconStyles />
    </Application.Styles>
</Application>
