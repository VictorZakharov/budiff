<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <Description>Standalone Avalonia GUI for budiff.</Description>
    <IsPackable>false</IsPackable>
    <!-- The tool package ships this app as a win-x64 NativeAOT publish (see
         the PublishGuiForPack target in Budiff.Cli.csproj). PublishAot must
         live HERE, not in that target's inner-MSBuild properties: restore
         only pulls the ILCompiler package when the project itself declares
         AOT, otherwise the flag is silently ignored and publish falls back
         to a plain (huge, slow) self-contained layout. Only publish is
         affected - build, test, and the dev-fallback exe stay JIT. -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <PublishAot>true</PublishAot>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.0.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.0.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.0.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.4" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="LibGit2Sharp" Version="0.31.0" />
    <PackageReference Include="Material.Icons.Avalonia" Version="3.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Budiff.Avalonia\Budiff.Avalonia.csproj" />
    <ProjectReference Include="..\Budiff.Avalonia.Markdown\Budiff.Avalonia.Markdown.csproj" />
    <ProjectReference Include="..\Budiff.Avalonia.TextMate\Budiff.Avalonia.TextMate.csproj" />
    <ProjectReference Include="..\Budiff.Core\Budiff.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Budiff.Shared\Git\*.cs" LinkBase="Shared\Git" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Budiff.Avalonia.Tests" />
  </ItemGroup>

  <!-- The app binds with reflection bindings (CompiledBindings off), so AOT
       trimming must not strip view-model members the XAML resolves at
       runtime - root all budiff assemblies. Without these roots the AOT app
       launches but every binding is dead (title stuck at "Window", empty
       tree). -->
  <ItemGroup>
    <TrimmerRootAssembly Include="Budiff.App" />
    <TrimmerRootAssembly Include="Budiff.Avalonia" />
    <TrimmerRootAssembly Include="Budiff.Core" />
    <TrimmerRootAssembly Include="Budiff.Avalonia.TextMate" />
    <TrimmerRootAssembly Include="Budiff.Avalonia.Markdown" />
  </ItemGroup>
</Project>
